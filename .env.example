# LLM provider. Only API_KEY is required when using a Groq key.
# To use another OpenAI-compatible provider (NVIDIA NIM, OpenAI, ...), also set API_BASE_URL and MODEL_NAME.
API_KEY=
API_BASE_URL=
MODEL_NAME=

# GitHub access for the PR reviewer (Pull requests: Read and write, Contents: Read)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Webhook server port (optional)
PORT=
